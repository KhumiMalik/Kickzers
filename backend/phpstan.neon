includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 8
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/
    tmpDir: storage/framework/cache/phpstan
    # Read model casts from the casts() method body, so enum/date/int casts are
    # known to the analyser (otherwise every cast column is typed as its raw DB type).
    parseModelCastsMethod: true
